# Application Port
PORT=5000

# MongoDB URI (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/whatsapp-collections?retryWrites=true&w=majority

# Twilio Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio Send WhatsApp Sandbox Number (must start with whatsapp:)
# Default Twilio Sandbox sender is: whatsapp:+14155238886
TWILIO_WHATSAPP=whatsapp:+14155238886

# Client CORS URLs (Optional)
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
